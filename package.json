{
  "name": "realitni-cenova-mapa",
  "version": "0.1.0",
  "private": true,
  "description": "Denní sběr realitních inzerátů (Sreality, Reality.idnes) do databáze a tvorba cenové mapy podle lokality a typu nemovitosti.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "collect": "tsx src/jobs/daily.ts",
    "collect:dry": "tsx src/jobs/daily.ts --dry-run",
    "collect:cuzk": "tsx src/jobs/cuzk.ts",
    "ingest:fixture": "tsx scripts/ingest-fixture.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "undici": "^6.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
