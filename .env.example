# --- Databáze ---
# MVP běží na SQLite (žádná instalace navíc). Soubor vznikne v prisma/dev.db.
DATABASE_URL="file:./dev.db"
# Pro produkci doporučeno PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://user:pass@localhost:5432/reality?schema=public"

# --- HTTP server ---
PORT=3000

# --- Collector ---
# Kolik stránek z každého portálu stáhnout za běh (50 inzerátů na stránku).
COLLECT_MAX_PAGES=5
# Prodleva mezi requesty v ms (šetrnost k portálu — nepřetěžovat!).
COLLECT_DELAY_MS=1200
# User-Agent, kterým se collector představuje.
COLLECT_USER_AGENT="realitni-cenova-mapa/0.1 (osobni vyzkum; kontakt: petr.uhlir@albixon.cz)"

# --- Detekce "prodáno" ---
# Po kolika dnech bez spatřeni se aktivní inzerát označí jako removed (odhad prodeje).
SOLD_AFTER_DAYS=7

# --- ČÚZK / WSDP (realizované ceny z katastru) ---
# Přihlašovací údaje k účtu WSDP. Zdarma lze začít na zkušebním prostředí:
# https://www.cuzk.gov.cz/.../Webove-sluzby-DP-na-zkousku.aspx
CUZK_WSDP_USER=""
CUZK_WSDP_PASSWORD=""
# Endpoint služby Sestavy WSDP (výchozí = zkušební/trial; uprav dle dokumentace).
CUZK_WSDP_ENDPOINT="https://wsdptrial.cuzk.cz/trial/ws/sestavy/V_2.9/sestavy"
# Kódy katastrálních území ke stažení, oddělené čárkou (např. 732541,610968).
# Tip: začni jen svými cílovými lokalitami — je to řádově levnější než celá ČR.
CUZK_TARGET_KU=""
# Prodleva mezi dotazy na jednotlivá KÚ (ms).
CUZK_DELAY_MS=1500
# Max. čekání na vygenerování jedné sestavy (s).
CUZK_POLL_TIMEOUT_SEC=120
