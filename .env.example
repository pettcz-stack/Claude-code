# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string
META_REDIRECT_URI=http://localhost:3000/auth/callback
META_GRAPH_VERSION=v21.0

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# Google Business Profile (volitelné — pro moderaci Google Maps recenzí).
# 1. https://console.cloud.google.com/ → Create project
# 2. Enable APIs: "My Business Account Management API", "My Business Business Information API", "Google My Business API"
# 3. OAuth consent screen → External → přidat si vlastní email jako test user
# 4. Credentials → Create OAuth client ID (Web application)
#    - Authorized redirect URI: http://localhost:3000/auth/google/callback (pro prod: https://viktor.albixon.cz/auth/google/callback)
# 5. Zkopíruj Client ID a Client secret sem:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# App
PORT=3000
DATABASE_URL=file:./dev.db
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=change-me
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Multi-user mode (recommended for teams — each operator gets own username in the audit log).
# Format: user:password[:role]  (role ∈ admin|moderator|viewer; default=admin).
# Multiple entries separated by commas.
#
# Roles:
#   admin     = full access (manage accounts/rules/templates/settings, delete)
#   moderator = hide/keep/reply, reclassify; CANNOT delete or change settings
#   viewer    = read-only (sees queue, audit, stats; no actions)
#
# Example:
#   DASHBOARD_USERS=honza:Heslo2026!:admin,petra:Heslo456!:moderator,karel:Heslo789!:viewer
#
# When set, overrides DASHBOARD_USERNAME + DASHBOARD_PASSWORD above.
DASHBOARD_USERS=

# Polling (minutes)
POLL_INTERVAL_MINUTES=5

# Auto-moderation defaults
AUTO_MODERATE_ENABLED=true
AUTO_DELETE_SPAM_THRESHOLD=0.90
AUTO_HIDE_VULGARITY_THRESHOLD=0.85

# Optional notifications — Slack webhook is preferred (one line to configure).
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL=

# Email delivery via SMTP (required only if NOTIFY_EMAIL is set and you want
# actual emails, not just log entries). Leave unset for Slack-only.
# Example for Gmail-style SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=viktor@albixon.cz
#   SMTP_PASS=<app-password>
#   SMTP_FROM=Viktor čistič <viktor@albixon.cz>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Security (production) ===
# Restrict API access to specific IPs/CIDRs (comma-separated). Empty = open.
# Example:  ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8,192.168.1.0/24
ALLOWED_IPS=

# Extra allowed CORS origins (comma-separated). Localhost is always allowed.
# Example:  CORS_EXTRA_ORIGIN=https://viktor.albixon.cz
CORS_EXTRA_ORIGIN=

# When running behind a TLS reverse proxy, set this so rate-limit & IP allowlist
# see the real client IP via X-Forwarded-For. Values: 'loopback' (safest),
# 'uniquelocal', or a specific proxy IP. Leave empty when Express is exposed
# directly (dev/localhost).
TRUST_PROXY=

# Frontend
VITE_API_BASE=http://localhost:3000
