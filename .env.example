# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string
META_REDIRECT_URI=http://localhost:3000/auth/callback
META_GRAPH_VERSION=v21.0

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# App
PORT=3000
DATABASE_URL=file:./dev.db
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=change-me
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Multi-user mode (recommended for teams — each operator gets own username in the audit log).
# Format: user1:password1,user2:password2  (no quotes, no spaces around commas).
# When set, overrides DASHBOARD_USERNAME + DASHBOARD_PASSWORD above.
# Example: DASHBOARD_USERS=honza:SvbPool2026!,petra:M0deraceX9$,karel:RybaVKomentu8@
DASHBOARD_USERS=

# Polling (minutes)
POLL_INTERVAL_MINUTES=5

# Auto-moderation defaults
AUTO_MODERATE_ENABLED=true
AUTO_DELETE_SPAM_THRESHOLD=0.90
AUTO_HIDE_VULGARITY_THRESHOLD=0.85

# Optional notifications
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL=

# === Security (production) ===
# Restrict API access to specific IPs/CIDRs (comma-separated). Empty = open.
# Example:  ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8,192.168.1.0/24
ALLOWED_IPS=

# Extra allowed CORS origins (comma-separated). Localhost is always allowed.
# Example:  CORS_EXTRA_ORIGIN=https://moderator.albixon.cz
CORS_EXTRA_ORIGIN=

# When running behind a TLS reverse proxy, set this so rate-limit & IP allowlist
# see the real client IP via X-Forwarded-For. Values: 'loopback' (safest),
# 'uniquelocal', or a specific proxy IP. Leave empty when Express is exposed
# directly (dev/localhost).
TRUST_PROXY=

# Frontend
VITE_API_BASE=http://localhost:3000
