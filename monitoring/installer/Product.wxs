<?xml version="1.0" encoding="UTF-8"?>
<!--
  Monitoring efektivity práce – MSI instalátor (WiX v4/v5).

  Nasazení přes AD/GPO: per-machine instalace (Scope="perMachine"), tichá
  (msiexec /qn). Nainstaluje agenta i hlídací službu (watchdog), která agenta
  spouští do session přihlášeného uživatele a po ukončení ho znovu nahodí.

  Konfigurace serveru se předává property:
    BACKENDURL, INGESTTOKEN, INTERVALSECONDS, SENDINTERVALSECONDS, CAPTURETITLE,
    IDLESECONDS, COMPANYNETWORKONLY, COMPANYPROBEHOST
  buď na příkazové řádce, nebo MST transformem pro GPO (viz deploy-gpo.md).

  Build vyžaduje rozšíření WixToolset.Util (kvůli automatickému restartu služby):
    wix extension add -g WixToolset.Util.wixext
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="MA win 32"
      Manufacturer="MA"
      Version="0.2.0"
      UpgradeCode="7d6a2c4e-9b1f-4a3d-9c2a-2f5e6b8c1a90"
      Scope="perMachine"
      Codepage="1250"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Je nainstalována novější verze." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Konfigurace serveru. Secure="yes" je nutné, aby se hodnoty z příkazové
         řádky přenesly i do elevované (per-machine) části instalace, která zapisuje
         registr. INGESTTOKEN je navíc Hidden (nezaloguje se). Properties bez výchozí
         hodnoty (token, probe host) nesmí mít prázdný Value (WiX v5 to zakazuje). -->
    <Property Id="BACKENDURL" Value="https://focus.firma.cz" Secure="yes" />
    <Property Id="INGESTTOKEN" Secure="yes" Hidden="yes" />
    <Property Id="INTERVALSECONDS" Value="60" Secure="yes" />
    <Property Id="SENDINTERVALSECONDS" Value="900" Secure="yes" />
    <Property Id="CAPTURETITLE" Value="0" Secure="yes" />
    <Property Id="IDLESECONDS" Value="300" Secure="yes" />
    <Property Id="COMPANYNETWORKONLY" Value="0" Secure="yes" />
    <Property Id="COMPANYPROBEHOST" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WorkView" />
    </StandardDirectory>

    <Feature Id="Main" Title="Monitoring efektivity práce" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">

      <!-- Spustitelný soubor agenta (běží v session uživatele). -->
      <Component Id="AgentExe" Bitness="always64">
        <File Id="AgentExeFile"
              Source="$(var.AgentExePath)"
              Name="MA win 32.exe"
              KeyPath="yes" />
      </Component>

      <!-- Hlídací služba (watchdog) + automatický restart při selhání. -->
      <Component Id="WatchdogExe" Bitness="always64">
        <File Id="WatchdogExeFile"
              Source="$(var.WatchdogExePath)"
              Name="MA win 32 Service.exe"
              KeyPath="yes" />
        <ServiceInstall Id="WatchdogSvc"
                        Name="MAWin32"
                        DisplayName="MA win 32"
                        Description="Zajišťuje běh monitoringu efektivity práce na firemním PC."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes" />
        <!-- Po selhání službu restartovat (5 s), reset počítadla po 1 dni. -->
        <util:ServiceConfig ServiceName="MAWin32"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
        <ServiceControl Id="WatchdogSvcCtl"
                        Name="MAWin32"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="no" />
      </Component>

      <!-- Konfigurace pro agenta. -->
      <Component Id="AgentConfigReg" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SOFTWARE\WorkView">
          <RegistryValue Name="BackendUrl" Type="string" Value="[BACKENDURL]" KeyPath="yes" />
          <RegistryValue Name="IngestToken" Type="string" Value="[INGESTTOKEN]" />
          <RegistryValue Name="IntervalSeconds" Type="string" Value="[INTERVALSECONDS]" />
          <RegistryValue Name="SendIntervalSeconds" Type="string" Value="[SENDINTERVALSECONDS]" />
          <RegistryValue Name="CaptureWindowTitle" Type="string" Value="[CAPTURETITLE]" />
          <RegistryValue Name="IdleThresholdSeconds" Type="string" Value="[IDLESECONDS]" />
          <RegistryValue Name="CompanyNetworkOnly" Type="string" Value="[COMPANYNETWORKONLY]" />
          <RegistryValue Name="CompanyProbeHost" Type="string" Value="[COMPANYPROBEHOST]" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
