# FOCUS backend – ukázková konfigurace. Zkopíruj do .env a uprav.
# V produkci (NODE_ENV=production) server odmítne start, pokud zde
# zůstanou výchozí/placeholder hodnoty (admin, zmente-me, dev-token, …).

# ───────────── Databáze ─────────────
# Dev (SQLite):
DATABASE_URL="file:./dev.db"
# Produkce (PostgreSQL) – použij se schema.postgres.prisma:
# DATABASE_URL="postgresql://focus:HESLO@db.intern.firma.cz:5432/focus?schema=public"

# ───────────── Prostředí ─────────────
NODE_ENV=development

# Povolený origin pro admin SPA (prázdné = same-origin přes reverzní proxy/nginx).
CORS_ORIGIN=

# HTTP port API
PORT=4000

# ───────────── Bezpečnost ─────────────
# Token pro autentizaci agenta při ingestu. V produkci MUSÍ být ≥ 24 znaků a unikátní.
# Generuj: openssl rand -hex 32
INGEST_TOKEN=__SET_BEFORE_FIRST_RUN__

# Výchozí admin účet do dashboardu. Heslo MUSÍ být ≥ 10 znaků a nesmí být admin/heslo/password.
# Generuj: openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASSWORD=__SET_BEFORE_FIRST_RUN__

# ───────────── Retence (dny) ─────────────
# Surová data se mažou po RAW_RETENTION_DAYS dnech, hodinové agregáty po HOURLY_RETENTION_DAYS.
RAW_RETENTION_DAYS=35
HOURLY_RETENTION_DAYS=540

# Délka intervalu agenta v sekundách (informativní, agent má vlastní config)
DEFAULT_INTERVAL_SECONDS=60

# ───────────── Demo data ─────────────
# Backfill HW snapshotů pro DEMO-PC-* zařízení (jen na ukázkové instalaci, NIKDY v produkci).
ENABLE_DEMO_DATA=false

# ───────────── E-mailové reporty (volitelné) ─────────────
# Aktivní jen při vyplněném SMTP_HOST a alespoň jednom příjemci.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=focus@firma.cz
REPORT_RECIPIENTS=sef@firma.cz,hr@firma.cz
REPORT_CRON=0 7 * * 1-5
REPORT_RANGE_DAYS=1
