# WorkView backend – ukázková konfigurace. Zkopíruj do .env a uprav.

# Dev (SQLite):
DATABASE_URL="file:./dev.db"

# Produkce (PostgreSQL) – použij se schema.postgres.prisma:
# DATABASE_URL="postgresql://workview:heslo@localhost:5432/workview?schema=public"

# HTTP port API
PORT=4000

# Délka intervalu agenta v sekundách (informativní, agent má vlastní config)
DEFAULT_INTERVAL_SECONDS=60
