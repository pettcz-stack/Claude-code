# WorkView backend – ukázková konfigurace. Zkopíruj do .env a uprav.

# Dev (SQLite):
DATABASE_URL="file:./dev.db"

# Produkce (PostgreSQL) – použij se schema.postgres.prisma:
# DATABASE_URL="postgresql://workview:heslo@localhost:5432/workview?schema=public"

# HTTP port API
PORT=4000

# Délka intervalu agenta v sekundách (informativní, agent má vlastní config)
DEFAULT_INTERVAL_SECONDS=60

# Token pro autentizaci agenta při ingestu (musí sedět s konfigurací agenta)
INGEST_TOKEN=dev-token

# Výchozí admin účet do dashboardu (vytvoří se jen pokud žádný neexistuje)
ADMIN_USER=admin
ADMIN_PASSWORD=zmente-me

# Retence (dny)
RAW_RETENTION_DAYS=35
HOURLY_RETENTION_DAYS=540

# E-mailové reporty (volitelné – aktivní jen při vyplněném SMTP_HOST a příjemcích)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=workview@firma.cz
REPORT_RECIPIENTS=sef@firma.cz,hr@firma.cz
REPORT_CRON=0 7 * * 1-5
REPORT_RANGE_DAYS=1
