# FOCUS DEMO – all-in-one image: frontend (statika) + backend + SQLite + demo data.
# Jeden port (8080), žádné externí závislosti, ideální pro „klikni a uvidíš".
#
# Build & run:  cd monitoring && docker compose -f docker-compose.demo.yml up
# Otevři:       http://localhost:8080  (admin / admin)

# ── 1) Frontend build ────────────────────────────────────────────────────────
FROM node:20-alpine AS fe
WORKDIR /fe
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ── 2) Backend build (TypeScript → JS) ───────────────────────────────────────
FROM node:20-alpine AS be
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY backend/tsconfig.json ./
COPY backend/prisma ./prisma
COPY backend/scripts ./scripts
COPY backend/src ./src
# Vygeneruje Prisma client pro SQLite a zkompiluje TypeScript.
# prisma:sync vytvoří postgres schema z mastera (pro případné nasazení).
RUN npm run prisma:sync \
 && npx prisma generate --schema=prisma/schema.prisma \
 && npm run build

# ── 3) Runtime image (jen prod závislosti + build artefakty) ─────────────────
FROM node:20-alpine
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app/backend
# tsx je potřeba kvůli seed skriptu (zachovejme dev deps).
COPY backend/package*.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY backend/prisma ./prisma
COPY backend/scripts ./scripts
COPY backend/src ./src
COPY --from=be /app/dist ./dist
COPY --from=be /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=be /app/node_modules/@prisma ./node_modules/@prisma
# Frontend build tam, kde ho backend servíruje (../frontend/dist).
COPY --from=fe /fe/dist /app/frontend/dist

# DB ukládáme do /data – mountnutelný volume, přežije restart kontejneru.
RUN mkdir -p /data
# Demo image POUŽÍVÁ záměrně slabé credentials (admin/admin, dev-token), aby
# bylo "klikni a uvidíš" bez konfigurace. Proto NODE_ENV=development –
# assertProductionSecrets() guard se aktivuje jen v production režimu a v demu
# by start zablokoval. Pro reálné nasazení viz Dockerfile (production-grade).
ENV NODE_ENV=development
ENV DATABASE_URL=file:/data/demo.db
ENV PORT=8080
ENV ADMIN_USER=admin
ENV ADMIN_PASSWORD=admin
ENV INGEST_TOKEN=dev-token
ENV ENABLE_JOBS=false
EXPOSE 8080

# Healthcheck pro docker / kubernetes — Prometheus si /metrics scrapuje sám.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/v1/health | grep -q '"status":"ok"' || exit 1

# Při startu: migrace → (volitelně) demo seed → server.
# - Seed se přeskakuje, když je SKIP_SEED=1 (CI smoke-test) nebo když už
#   sentinel /data/.seeded-v2 existuje (druhý a další start kontejneru).
# - Sentinel je verzovaný: po každém přidání nového typu dat (Print/USB, atd.)
#   bumpneme suffix, aby se po upgradu image znovu naseedovala nová data.
# - Lokálně bez nastavení SKIP_SEED se seed spustí jednou pro fresh volume.
# - Seed je idempotentní (upsert pro mastery, skipDuplicates pro intervaly).
CMD sh -c "npx prisma migrate deploy && \
  ( [ \"$SKIP_SEED\" = '1' ] && echo 'Seed přeskočen (SKIP_SEED=1)' \
    || [ -f /data/.seeded-v2 ] && echo 'Seed přeskočen (.seeded-v2 existuje)' \
    || ( npm run seed && touch /data/.seeded-v2 ) ) && \
  node dist/index.js"
