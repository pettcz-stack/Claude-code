<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Název služby/EXE: "MA win 32 Service.exe" -->
    <AssemblyName>MA win 32 Service</AssemblyName>
    <AssemblyTitle>MA win 32 Service</AssemblyTitle>
    <Product>MA win 32</Product>
    <Version>0.3.0</Version>
    <Company>MA</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies pro .NET Framework 4.8 z NuGetu – build pak nezávisí
         na targeting packu předinstalovaném na runneru (CI windows-2022/2025). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
