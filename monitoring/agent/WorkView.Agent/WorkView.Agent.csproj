<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <!-- Název procesu/EXE zobrazený ve Správci úloh: "MA win 32.exe" -->
    <AssemblyName>MA win 32</AssemblyName>
    <AssemblyTitle>MA win 32</AssemblyTitle>
    <Product>MA win 32</Product>
    <Version>0.2.0</Version>
    <Company>MA</Company>
    <!-- Cílíme net48 kvůli nejširší kompatibilitě napříč verzemi Windows
         (Win 7 SP1+ až Win 11, Windows Server 2008 R2+). Runtime .NET Framework
         4.8 je předinstalovaný na Win10 1903+ a doinstalovatelný jinde. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies pro .NET Framework 4.8 z NuGetu – build pak nezávisí
         na targeting packu předinstalovaném na runneru (CI windows-2022/2025). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- V SDK-style net48 není System.Net.Http implicitně referencováno. -->
    <Reference Include="System.Net.Http" />
    <!-- GZip komprese odesílané dávky (menší přenos po síti). -->
    <Reference Include="System.IO.Compression" />
    <!-- WMI dotazy pro HW telemetrii (baterie, disky, RAM, BIOS, antivirus). -->
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
