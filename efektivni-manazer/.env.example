# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# Modely pro extrakci a drafty (lze přepsat)
LLM_EXTRACTOR_MODEL=claude-sonnet-4-6
LLM_DRAFT_MODEL=claude-opus-4-7

# --- Aplikace ---
# Master heslo pro přihlášení do UI (při prvním běhu se z něj vytvoří hash v DB)
EFEKTIVNI_MASTER_PASSWORD=zmen-me-prosim

# Fernet klíč pro šifrování IMAP credentials v DB
# Vygenerovat: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EFEKTIVNI_ENCRYPTION_KEY=

# Tajný klíč pro podpis session cookies
EFEKTIVNI_SESSION_SECRET=zmen-me-na-nahodny-retezec

# --- DB ---
POSTGRES_USER=efektivni
POSTGRES_PASSWORD=efektivni
POSTGRES_DB=efektivni
DATABASE_URL=postgresql+psycopg://efektivni:efektivni@db:5432/efektivni

# --- Sync ---
# Jak často kontrolovat mailbox (sekundy)
MAIL_SYNC_INTERVAL=120
# Jak často vyhodnocovat SLA pravidla (sekundy)
SLA_TICK_INTERVAL=300

# --- Web ---
# URL API z prohlížeče (Next.js běží v dockeru, ale fetch jde z browseru)
NEXT_PUBLIC_API_URL=http://localhost:8091

# --- Pracovní doba (pro SLA - kdy se počítá čas) ---
WORKING_HOURS_START=8
WORKING_HOURS_END=18
WORKING_DAYS=1,2,3,4,5
TIMEZONE=Europe/Prague
