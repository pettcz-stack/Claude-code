# Caddyfile pro moderátor komentářů ALBIXON
# ------------------------------------------
# Caddy získá TLS certifikát automaticky přes Let's Encrypt — jediné, co
# musíš udělat, je:
#   1. Nasměrovat DNS A/AAAA záznam `moderator.albixon.cz` na tento server.
#   2. Otevřít porty 80 + 443.
#   3. Nahradit `moderator.albixon.cz` svojí skutečnou doménou níže.
#   4. `caddy run --config /etc/caddy/Caddyfile` nebo systemd službou.
#
# Aplikace běží na localhost:3001 (hodnota z PORT v .env).
# V .env zároveň nastav:
#   TRUST_PROXY=loopback        — aby app viděla skutečné klientské IP přes X-Forwarded-For
#   ALLOWED_IPS=10.0.0.0/8      — rozsah firemní sítě/VPN (volitelné ale doporučené)
#   CORS_EXTRA_ORIGIN=https://moderator.albixon.cz

{
	# Globální options. E-mail je pro Let's Encrypt expirační notifikace.
	email it@albixon.cz

	# Přísnější bezpečnostní logging (produkce).
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 14
		}
		format json
	}
}

moderator.albixon.cz {
	# --- Hlavní proxy na Node aplikaci ---
	reverse_proxy 127.0.0.1:3001 {
		# Předej skutečnou klientskou IP (pro rate-limit + IP allowlist uvnitř app).
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# Timeouts.
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	# --- Bezpečnostní hlavičky (nad rámec helmetu v app) ---
	header {
		# HSTS s preload (opt-in na 1 rok po ověření, že TLS funguje).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Skrýt technologie.
		-Server
		-X-Powered-By

		# Cross-origin ochrany (nad rámec aplikace).
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Permissions-Policy: vypnout funkce co v dashboardu nepotřebujeme.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# --- Volitelné: Caddy-level rate-limit jako druhá vrstva ---
	# Vyžaduje plugin `caddy-ratelimit` — stáhni Caddy build s ním pokud chceš.
	# Jinak nech zakomentované — aplikace má vlastní express-rate-limit.
	#
	# rate_limit {
	#	zone auth_burst {
	#		key {remote_host}
	#		events 30
	#		window 15m
	#	}
	#	match path /auth*
	# }

	# --- Zdravotní endpoint nechávám otevřený i pro monitoring ---
	# /health a /health/ready jsou bez auth (viz aplikace).

	# --- Volitelné: omezení přístupu na firemní VPN ---
	# Odkomentuj a přidej správné rozsahy, pokud chceš omezit i na Caddy úrovni.
	#
	# @outside_vpn not remote_ip 10.0.0.0/8 192.168.0.0/16 127.0.0.1
	# respond @outside_vpn 403

	encode zstd gzip
}

# --- Varianta 2: pouze za VPN, bez veřejné domény ---
# Pokud běží jen uvnitř firemního intranetu, použij interní jméno s vlastní CA:
#
# moderator.albixon.local:443 {
#     tls /etc/caddy/tls/internal.crt /etc/caddy/tls/internal.key
#     reverse_proxy 127.0.0.1:3001 {
#         header_up X-Forwarded-For {remote_host}
#     }
# }
