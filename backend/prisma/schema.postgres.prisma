// Production variant: PostgreSQL.
// Usage:
//   cp prisma/schema.postgres.prisma prisma/schema.prisma
//   (then update DATABASE_URL in .env to postgresql://...)
//
// The schema is identical to the SQLite version. Prisma raw-SQL used by
// stats routes is SQLite-specific (substr/julianday) — rewrite to
// date_trunc / EXTRACT(EPOCH ...) before switching to Postgres. See
// README.md "Production deployment" section for details.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                     String    @id @default(cuid())
  platform               String
  pageId                 String    @unique
  pageName               String
  accessTokenEncrypted   String
  tokenExpiresAt         DateTime?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  posts                  Post[]

  @@index([platform])
  @@index([active])
}

model Post {
  id                String    @id @default(cuid())
  accountId         String
  platformPostId    String    @unique
  postedAt          DateTime?
  contentPreview    String?
  permalink         String?
  createdAt         DateTime  @default(now())

  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  comments          Comment[]

  @@index([accountId])
}

model Comment {
  id                 String    @id @default(cuid())
  postId             String
  platformCommentId  String    @unique
  authorName         String?
  authorId           String?
  text               String
  createdAtPlatform  DateTime?
  parentCommentId    String?
  status             String    @default("new")
  fetchedAt          DateTime  @default(now())

  post               Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  classifications    Classification[]
  actions            Action[]

  @@index([status])
  @@index([postId])
  @@index([authorId])
}

model Classification {
  id                 String    @id @default(cuid())
  commentId          String
  category           String
  confidence         Float
  reasoning          String
  recommendedAction  String
  detectedLanguage   String?
  modelUsed          String
  classifiedAt       DateTime  @default(now())

  comment            Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([category])
}

model Action {
  id                 String    @id @default(cuid())
  commentId          String
  actionType         String
  performedBy        String
  performedAt        DateTime  @default(now())
  apiResponse        String?
  success            Boolean   @default(true)
  errorMessage       String?

  comment            Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([performedAt])
}

model Rule {
  id               String   @id @default(cuid())
  name             String
  category         String
  minConfidence    Float    @default(0.9)
  action           String
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ListEntry {
  id        String   @id @default(cuid())
  kind      String
  value     String
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ReplyTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String?
  body        String
  language    String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Evidence {
  id                 String   @id @default(cuid())
  commentId          String
  category           String
  capturedAt         DateTime @default(now())
  contentHash        String
  snapshotJson       String
  permalinkAtCapture String?

  @@index([commentId])
  @@index([category])
  @@index([capturedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  event      String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
